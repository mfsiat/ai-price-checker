# Backend configuration (see app/config.py). Copy to .env or set in your
# deployment platform. All values shown are the development defaults.

# development | staging | production
# In production the app refuses to boot with a wildcard/missing CORS origin.
ENVIRONMENT=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Standard logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: override the pricing data file path.
# PRICING_FILE=/path/to/pricing.json
